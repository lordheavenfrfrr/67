      visualFolder.addColor(MOD, "BuildingOwnerEnemyColor").name("Enemy Owner Color");
    }
    makeAcc(visualFolder);

    /* ==================== MISC ==================== */
    const miscFolder = gui.addFolder("Misc");
    miscFolder.add(BabaConfig, "RightClickEnabled").name("Open Door (Right Click)").listen();
    miscFolder.add(BabaConfig, "PlayersListEnabled").name("Player List").listen();
    miscFolder.add(BabaConfig, "PlayerId").name("Player ID");
    miscFolder.add({ copyOne: function () { clbCopyID(BabaConfig.PlayerId); } }, "copyOne").name("Copy Name");
    miscFolder.add({ copyAll: function () { clbCopyAll(); } }, "copyAll").name("Copy All Names");
    makeAcc(miscFolder);

    /* ==================== SYSTEMS ==================== */
    const systemsFolder = gui.addFolder("Systems");
    systemsFolder.add(BabaConfig, "AutoBuildEnabled").name("AutoBuild").listen();
    systemsFolder.add(BabaConfig, "FAutoLootEnabled").name("FAutoLoot").listen().onChange(function () {
      if (typeof AimbotSaveConfig === "function") AimbotSaveConfig();
    });
    systemsFolder.add(BabaConfig, "AutoRun").name("AutoRun").listen().onChange(function (v) {
      applyAutoRun(!!v);
      if (typeof AimbotSaveConfig === "function") AimbotSaveConfig();
    });
    systemsFolder.add(BabaConfig, "AntiKickEnabled").name("Anti-Kick").listen();
    makeAcc(systemsFolder);

    /* ==================== CAMERA ==================== */
    const cameraFolder = gui.addFolder("Camera");
    cameraFolder.add(BabaConfig, "zoom", -1, 1).step(0.05).listen().name("Zoom");
    cameraFolder.add({ in: function () { modifyZoom(1); } }, "in").name("Zoom In");
    cameraFolder.add({ out: function () { modifyZoom(-1); } }, "out").name("Zoom Out");
    makeAcc(cameraFolder);

    /* ==================== CHAT ==================== */
    const chatFolder = gui.addFolder("Chat");
    chatFolder.add(BabaConfig, "SpamChatEnabled").name("Spam Chat").onChange(manageSpammer);
    chatFolder.add(BabaConfig, "SpamChatText").name("Chat Text");
    makeAcc(chatFolder);

    /* ==================== ACCOUNT / CONFIG ==================== */
    const tokenFolder = gui.addFolder("Token Changer");
    tokenFolder.add({ copy: function () { TokenChanger.copy(); } }, "copy").name("Copy");
    const tokenInput = tokenFolder.add(BabaConfig, "token").name("Pasted Token");
    tokenFolder.add({ change: function () { parseTk(BabaConfig.token); TokenChanger.change(tokenInput); } }, "change").name("Change");
    tokenFolder.add({ reset: function () { TokenChanger.reset(); } }, "reset").name("Reset");
    makeAcc(tokenFolder);

    const configFolder = gui.addFolder("Config");
    configFolder.add({ save: function () {
      try {
        const outCfg = {};
        for (let x in BaseSettings) outCfg[x] = BabaConfig[x];
        localStorage.setItem("BABA_MOD_CFG", JSON.stringify(outCfg));
      } catch (e) {}
    } }, "save").name("Save Config");
    configFolder.add({ reset: function () {
      try { localStorage.removeItem("BABA_MOD_CFG"); } catch (e) {}
      location.reload();
    } }, "reset").name("Reset Config");
    makeAcc(configFolder);

    AimbotHookSave(gui);
    attachVisualHacks();
    if (typeof manageSpammer === "function" && BabaConfig.SpamChatEnabled) manageSpammer(true);

    window.addEventListener("keydown", function (ev) {
      try {
        const tg = ev.target;
        if (tg && (tg.tagName === "INPUT" || tg.tagName === "TEXTAREA" || tg.isContentEditable)) return;
        if (ev.code !== BabaConfig.ModMenuKey) return;
        gui.domElement.style.display = gui.domElement.style.display === "none" ? "" : "none";
        ev.stopImmediatePropagation();
        ev.preventDefault();
      } catch (e) {}
    }, true);
    gui.domElement.style.display = "none";
    aimFolder.open();
  }
  օᄄ︃.AimbotMenuInit = AimbotMenuInit;
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", AimbotMenuInit);
  } else {
    AimbotMenuInit();
  }



})();
